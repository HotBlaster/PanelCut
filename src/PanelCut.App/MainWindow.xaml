<Window x:Class="PanelCut.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PanelCut.App.Controls"
        Title="PanelCut" Width="1280" Height="800" MinWidth="960" MinHeight="640"
        Background="#F3F5F5" Foreground="#222C2C" FontFamily="Bahnschrift, Segoe UI" FontSize="14"
        Loaded="WindowLoaded" Closing="WindowClosing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style x:Key="RowActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2,0"/><Setter Property="Focusable" Value="False"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Tag" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8E7"/><Setter Property="AlternatingRowBackground" Value="#F5F8F7"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CDD5D3"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <!-- Pixel scrolling: the rows share the scroll content with the add row below them. -->
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGrid">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
                                <ScrollViewer.Template>
                                    <ControlTemplate TargetType="ScrollViewer">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Button Command="{x:Static DataGrid.SelectAllCommand}" Focusable="False"
                                                    Style="{DynamicResource {ComponentResourceKey ResourceId=DataGridSelectAllButtonStyle, TypeInTargetAssembly={x:Type DataGrid}}}"
                                                    Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.All}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    Width="{Binding CellsPanelHorizontalOffset, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" Grid.Column="1"
                                                    Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Column}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1" Grid.ColumnSpan="2"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="1" Grid.Column="2" Orientation="Vertical"
                                                    Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                                    Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                            <Grid Grid.Row="2" Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding NonFrozenColumnsViewportHorizontalOffset, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="1" Orientation="Horizontal"
                                                        Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                                        Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                                        Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                            </Grid>
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollViewer.Template>
                                <StackPanel>
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    <Border x:Name="AddRow" Height="34">
                                        <Button Content="+" Click="RowAddClick" Style="{StaticResource RowActionButtonStyle}" HorizontalAlignment="Left"
                                                ToolTip="Add a row" AutomationProperties.Name="Add row"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="AddRow" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <Style x:Key="CellNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="CellTextEditorStyle" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>
        <Style x:Key="CellNumberEditorStyle" TargetType="TextBox" BasedOn="{StaticResource CellTextEditorStyle}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="CellMaterialStyle" TargetType="ComboBox" BasedOn="{x:Static DataGridComboBoxColumn.DefaultElementStyle}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="CellMaterialEditorStyle" TargetType="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <DataTemplate x:Key="PartColorCellTemplate">
            <Button Click="PartColorClick" Margin="4,0" Padding="3" MinHeight="0" Height="24" Width="56"
                    ToolTip="Choose colour" AutomationProperties.Name="Choose colour">
                <Border Background="{Binding Color}" BorderBrush="#7A8A86" BorderThickness="1" Width="44" Height="14"/>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="RowActionsTemplate">
            <Button Content="-" Click="RowRemoveClick" Style="{StaticResource RowActionButtonStyle}" HorizontalAlignment="Left"
                    ToolTip="Delete this row" AutomationProperties.Name="Delete row"/>
        </DataTemplate>
        <DataTemplate x:Key="EnabledRowActionsTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="-" Click="RowRemoveClick" Style="{StaticResource RowActionButtonStyle}"
                        ToolTip="Delete this row" AutomationProperties.Name="Delete row"/>
                <Button Click="RowEnabledClick" AutomationProperties.Name="Toggle enabled">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RowActionButtonStyle}">
                            <Setter Property="ToolTip" Value="Enabled: exclude from optimization"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter Property="ToolTip" Value="Disabled: include in optimization"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <!-- Segoe MDL2 lacks the "Hide" glyph on Windows 10, so the slash is drawn. -->
                    <Grid Width="16" Height="16">
                        <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontWeight="Normal" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Line X1="2" Y1="14" X2="14" Y2="2" StrokeThickness="1.6"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                            <Line.Style>
                                <Style TargetType="Line">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Line.Style>
                        </Line>
                    </Grid>
                </Button>
            </StackPanel>
        </DataTemplate>
        <!-- Fades disabled items; never bind DataGridRow.IsEnabled or the toggle could not re-enable it. -->
        <Style x:Key="EnabledRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabItem"><Setter Property="Padding" Value="18,10"/></Style>
        <Style x:Key="MaterialTabsStyle" TargetType="TabControl">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate><TextBlock Text="{Binding Display}" MaxWidth="240" TextWrapping="Wrap"/></DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="controls:PositiveNumberInput">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:PositiveNumberInput">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                <Grid Grid.Column="1">
                                    <Grid.Resources>
                                        <Style TargetType="RepeatButton">
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                            <Setter Property="FontSize" Value="10"/>
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <RepeatButton Content="&#xE70E;" Command="{x:Static controls:PositiveNumberInput.Increase}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  ToolTip="Increase thickness by 1 mm" AutomationProperties.Name="Increase thickness"/>
                                    <RepeatButton Grid.Row="1" Content="&#xE70D;" Command="{x:Static controls:PositiveNumberInput.Decrease}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  ToolTip="Decrease thickness by 1 mm" AutomationProperties.Name="Decrease thickness"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu x:Name="FileMenu" DockPanel.Dock="Top" Background="White" Padding="8,4">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project" InputGestureText="Ctrl+N" Click="NewProjectClick"/>
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Click="OpenProjectClick"/>
                <Separator/><MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="SaveProjectClick"/>
                <MenuItem Header="Save _As..." Click="SaveAsClick"/><Separator/>
                <MenuItem Header="_Import Cut List..." Click="ImportPartsClick"/><Separator/><MenuItem Header="E_xit" Click="ExitClick"/>
            </MenuItem>
            <MenuItem x:Name="ConfigurationMenu" Header="_Configuration">
                <MenuItem x:Name="OpenInventoryFolderMenuItem" Header="Open _Inventory Folder" Click="OpenInventoryFolderClick"/>
                <MenuItem x:Name="OpenMaterialsFolderMenuItem" Header="Open _Materials Folder" Click="OpenMaterialsFolderClick"/>
                <MenuItem x:Name="OpenBladesFolderMenuItem" Header="Open _Blades Folder" Click="OpenBladesFolderClick"/>
            </MenuItem>
        </Menu>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#CDD5D3" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <Button x:Name="OptimizeButton" DockPanel.Dock="Right" Content="Optimize" Background="#17665D" Foreground="White"
                        Padding="24,8" Click="OptimizeClick" AutomationProperties.AutomationId="Optimize"/>
                <StackPanel><TextBlock Text="PanelCut" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProjectName" Text="Untitled project" Foreground="#5C6A68" Margin="0,3,0,0"/></StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#E8EFEC" Padding="16,8">
            <StackPanel><ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,6"/>
                <TextBox x:Name="Status" Text="Loading inventory..." TextWrapping="Wrap" IsReadOnly="True"
                         BorderThickness="0" Background="Transparent" Padding="0"
                         AutomationProperties.AutomationId="Status"/></StackPanel>
        </Border>
        <TabControl x:Name="Views" Margin="16" Background="White" SelectionChanged="ViewChanged">
            <TabItem x:Name="ProjectTab" Header="Project">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,18">
                        <TextBlock Text="Blade" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="BladeInput" Width="380" Padding="6,4" DisplayMemberPath="Display" SelectedValuePath="Id"
                                  SelectionChanged="BladeChanged" AutomationProperties.AutomationId="Blade"
                                  ToolTip="Saw blade used for this project; its kerf is used by the optimizer"/>
                        <TextBlock x:Name="KerfDisplay" Text="Kerf: select a blade" VerticalAlignment="Center" Foreground="#5C6A68" Margin="10,0,24,0"
                                   AutomationProperties.AutomationId="Kerf"/>
                        <TextBlock Text="Units" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="UnitInput" Width="100" Padding="4" SelectionChanged="UnitChanged" AutomationProperties.AutomationId="Units"/>
                        <TextBlock Text="Cut pattern" VerticalAlignment="Center" Margin="24,0,8,0"/>
                        <ComboBox x:Name="CutPatternInput" Width="120" Padding="4" SelectionChanged="CutPatternChanged" AutomationProperties.AutomationId="CutPattern"
                                  ToolTip="By length: strips along the sheet's long side. By width: strips across it. Optimal: mixed cut directions."/>
                    </WrapPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="AddPartButton" Content="+ Part" Click="AddPartClick" AutomationProperties.AutomationId="AddPart"/>
                        <Button x:Name="ImportPartsButton" Content="Import CSV..." Click="ImportPartsClick" AutomationProperties.AutomationId="ImportParts"
                                ToolTip="Append parts from a CSV cut list (columns: Label, Width, Height, Quantity, Material, Type, Thickness, Color; lengths in mm; Type/Thickness optional checks; Color as #RRGGBB)"/>
                        <Button Content="Delete" Click="DeletePartClick" ToolTip="Delete selected parts"/>
                        <Button Content="Cancel edit" Click="CancelPartClick" Focusable="False"/>
                        <TextBlock x:Name="PartCount" VerticalAlignment="Center" Foreground="#5C6A68" Margin="12,0,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="PartsGrid" Grid.Row="2" SelectionMode="Extended" SelectionUnit="FullRow" RowEditEnding="PartRowEnding" AutomationProperties.AutomationId="PartsGrid"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="PanelsTab" Header="Panels">
                <DockPanel Margin="14">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Panels - mm" FontSize="18" FontWeight="SemiBold"/>
                        <TextBox x:Name="InventoryLocation" Foreground="#5C6A68" Margin="0,4,0,10"
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                 AutomationProperties.Name="Inventory file path"/>
                        <WrapPanel>
                            <Button x:Name="AddPanelButton" Content="+ Panel" Click="AddPanelClick" AutomationProperties.AutomationId="AddPanel"/>
                            <Button x:Name="DeleteStockButton" Content="Delete" Click="DeleteStockClick" ToolTip="Delete selected panels"/>
                            <Button x:Name="RetryEditButton" Content="Save" Click="RetryStockClick"/>
                            <Button Content="Cancel edit" Click="CancelStockClick" Focusable="False"/>
                            <Button Content="Reload stock" Click="ReloadStockClick"/>
                        </WrapPanel>
                    </StackPanel>
                    <TabControl x:Name="PanelMaterialTabs" DockPanel.Dock="Top" Style="{StaticResource MaterialTabsStyle}"
                                SelectionChanged="StockMaterialChanged" AutomationProperties.Name="Panel materials"/>
                    <DataGrid x:Name="PanelsGrid" SelectionMode="Extended" SelectionUnit="FullRow" CanUserReorderColumns="True" RowEditEnding="StockRowEnding" AutomationProperties.AutomationId="PanelsGrid"/>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="ScrapsTab" Header="Scraps">
                <DockPanel Margin="14">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Scraps - mm" FontSize="18" FontWeight="SemiBold"/>
                        <TextBox x:Name="ScrapsLocation" Foreground="#5C6A68" Margin="0,4,0,10"
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                 AutomationProperties.Name="Inventory file path"/>
                        <WrapPanel>
                            <Button x:Name="AddScrapButton" Content="+ Scrap" Click="AddScrapClick" AutomationProperties.AutomationId="AddScrap"/>
                            <Button x:Name="DeleteScrapsButton" Content="Delete" Click="DeleteStockClick" ToolTip="Delete selected scraps"/>
                            <Button x:Name="SaveScrapsButton" Content="Save" Click="RetryStockClick"/>
                            <Button Content="Cancel edit" Click="CancelStockClick" Focusable="False"/>
                            <Button Content="Reload stock" Click="ReloadStockClick"/>
                        </WrapPanel>
                    </StackPanel>
                    <TabControl x:Name="ScrapMaterialTabs" DockPanel.Dock="Top" Style="{StaticResource MaterialTabsStyle}"
                                SelectionChanged="StockMaterialChanged" AutomationProperties.Name="Scrap materials"/>
                    <DataGrid x:Name="ScrapsGrid" SelectionMode="Extended" SelectionUnit="FullRow" CanUserReorderColumns="True" RowEditEnding="StockRowEnding" AutomationProperties.AutomationId="ScrapsGrid"/>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="LayoutTab" Header="Layout">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="Metrics" Text="No layout" FontSize="18" Margin="0,0,0,14"/>
                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" Width="36" Padding="0" ToolTip="Previous sheet" AutomationProperties.Name="Previous sheet" Click="PreviousSheetClick"/>
                            <Button Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" Width="36" Padding="0" ToolTip="Next sheet" AutomationProperties.Name="Next sheet" Click="NextSheetClick"/>
                        </StackPanel>
                        <ComboBox x:Name="SheetSelector" Padding="6" SelectionChanged="SheetChanged" AutomationProperties.AutomationId="SheetSelector"/>
                    </DockPanel>
                    <Border x:Name="DrawingHost" Grid.Row="2" Background="#EDF1F0" BorderBrush="#CDD5D3" BorderThickness="1" ClipToBounds="True"/>
                    <Expander x:Name="UnplacedExpander" Grid.Row="3" Header="Unplaced parts" Margin="0,10,0,0" Visibility="Collapsed">
                        <DataGrid x:Name="UnplacedGrid" IsReadOnly="True" MaxHeight="160"/>
                    </Expander>
                </Grid>
            </TabItem>
            <TabItem x:Name="MaterialsTab" Header="Materials">
                <DockPanel Margin="14">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Materials" FontSize="18" FontWeight="SemiBold"/>
                        <TextBox x:Name="MaterialsLocation" Foreground="#5C6A68" Margin="0,4,0,10"
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                 AutomationProperties.Name="Materials file path"/>
                        <WrapPanel>
                            <Button x:Name="AddMaterialButton" Content="+ Material" Click="AddMaterialClick" AutomationProperties.AutomationId="AddMaterial"/>
                            <Button x:Name="CommitMaterialButton" Content="Save" Click="RetryMaterialClick"/>
                            <Button Content="Cancel edit" Click="CancelMaterialClick" Focusable="False"/>
                            <Button Content="Reload materials" Click="ReloadMaterialsClick"/>
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="MaterialsGrid" BeginningEdit="MaterialBeginningEdit" RowEditEnding="MaterialRowEnding"
                              AutomationProperties.AutomationId="MaterialsGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="230" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="2,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox"><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Type" Width="200" SortMemberPath="Type">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Type}" VerticalAlignment="Center" Margin="2,0"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" IsTextSearchEnabled="False"
                                                  VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                                                  ItemsSource="{Binding DataContext.MaterialTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Text="{Binding Type, UpdateSourceTrigger=LostFocus}"
                                                  DropDownClosed="MaterialTypeDropDownClosed"
                                                  ToolTip="Select an existing type or enter a new one"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Thickness mm" Width="140" SortMemberPath="Thickness">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Thickness}" VerticalAlignment="Center" TextAlignment="Right" Margin="2,0"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <controls:PositiveNumberInput Text="{Binding Thickness, UpdateSourceTrigger=LostFocus}"
                                                                      AutomationProperties.Name="Material thickness in mm"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="BladesTab" Header="Blades">
                <DockPanel Margin="14">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Blades - mm" FontSize="18" FontWeight="SemiBold"/>
                        <TextBox x:Name="BladesLocation" Foreground="#5C6A68" Margin="0,4,0,10"
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                 AutomationProperties.Name="Blades file path"/>
                        <WrapPanel>
                            <Button x:Name="AddBladeButton" Content="+ Blade" Click="AddBladeClick" AutomationProperties.AutomationId="AddBlade"/>
                            <Button x:Name="DeleteBladesButton" Content="Delete" Click="DeleteBladesClick" ToolTip="Delete selected blades"/>
                            <Button x:Name="SaveBladesButton" Content="Save" Click="RetryBladeClick"/>
                            <Button Content="Cancel edit" Click="CancelBladeClick" Focusable="False"/>
                            <Button Content="Reload blades" Click="ReloadBladesClick"/>
                        </WrapPanel>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Right" Width="250" Margin="14,0,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Brands" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="AddBrandButton" Content="+ Brand" Click="AddBrandClick" AutomationProperties.AutomationId="AddBrand"/>
                                <Button x:Name="DeleteBrandsButton" Content="Delete" Click="DeleteBrandsClick" Margin="0" ToolTip="Delete selected unused brands"/>
                            </StackPanel>
                        </DockPanel>
                        <DataGrid x:Name="BrandsGrid" SelectionMode="Extended" SelectionUnit="FullRow" BeginningEdit="BladeBeginningEdit"
                                  RowEditEnding="BladeRowEnding" AutomationProperties.AutomationId="BrandsGrid"/>
                    </DockPanel>
                    <DataGrid x:Name="BladesGrid" SelectionMode="Extended" SelectionUnit="FullRow" BeginningEdit="BladeBeginningEdit"
                              RowEditEnding="BladeRowEnding" AutomationProperties.AutomationId="BladesGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="200" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource CellTextStyle}" EditingElementStyle="{StaticResource CellTextEditorStyle}"/>
                            <DataGridTemplateColumn Header="Brand" Width="170" SortMemberPath="Brand">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Brand}" Style="{StaticResource CellTextStyle}"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <controls:BrandPicker Text="{Binding Brand, UpdateSourceTrigger=LostFocus}"
                                                              Brands="{Binding DataContext.BrandNames, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              AutomationProperties.Name="Blade brand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Brand code" Width="140" Binding="{Binding BrandCode, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource CellTextStyle}" EditingElementStyle="{StaticResource CellTextEditorStyle}"/>
                            <DataGridTextColumn Header="Diameter mm" Width="115" Binding="{Binding Diameter, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource CellNumberStyle}" EditingElementStyle="{StaticResource CellNumberEditorStyle}"/>
                            <DataGridTextColumn Header="Teeth" Width="75" Binding="{Binding Teeth, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource CellNumberStyle}" EditingElementStyle="{StaticResource CellNumberEditorStyle}"/>
                            <DataGridTextColumn Header="Kerf mm" Width="90" Binding="{Binding Kerf, UpdateSourceTrigger=PropertyChanged}"
                                                ElementStyle="{StaticResource CellNumberStyle}" EditingElementStyle="{StaticResource CellNumberEditorStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
